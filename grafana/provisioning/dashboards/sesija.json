      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT formatDateTime(min(ts), '%d.%m.%Y. %H:%i:%S', 'Europe/Zagreb') AS pocetak FROM analytics.events WHERE app = 'domovina.ai' AND session_id = ${session:sqlstring}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
