      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(prev, '  →  ', kind) AS prijelaz, count() AS n FROM (SELECT session_id, ts, replaceRegexpOne(route, '^/(v|m|yt|c|p)/.*', '/\\\\1/…') AS kind, lagInFrame(replaceRegexpOne(route, '^/(v|m|yt|c|p)/.*', '/\\\\1/…'), 1, '(ulaz)') OVER (PARTITION BY session_id ORDER BY ts ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS prev FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) AND event = 'screen_view') WHERE prev != kind GROUP BY prijelaz ORDER BY n DESC LIMIT 25"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
