  "panels": [
    {
      "type": "bargauge",
      "title": "Lijevak sesije",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "w": 12,
        "h": 9,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS `1. sesija`, countIf(ep > 0) AS `2. otvorio epizodu`, countIf(ep_s >= 60) AS `3. minuta na epizodi`, countIf(ep_s >= 300) AS `4. 5 minuta na epizodi`, countIf(ep_s >= 300 AND eps >= 2) AS `5. i druga epizoda` FROM (SELECT session_id, countIf(event = 'screen_view' AND vid != '') AS ep, sumIf(dwell_s, vid != '') AS ep_s, uniqExactIf(vid, vid != '') AS eps FROM (SELECT *, least(dateDiff('second', ts, leadInFrame(ts, 1, ts) OVER w), 300) AS dwell_s, ifNull(anyLast(nullIf(route, '')) OVER w_cur, '') AS screen, extract(screen, '^/(?:v|m|yt)/([^/?#]+)') AS vid, extract(screen, '^/c/([^/?#]+)') AS ch, extract(screen, '^/p/([^/?#]+)') AS person FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) WINDOW w AS (PARTITION BY session_id ORDER BY ts ROWS BETWEEN CURRENT ROW AND 1 FOLLOWING), w_cur AS (PARTITION BY session_id ORDER BY ts ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)) GROUP BY session_id)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 16,
        "maxVizHeight": 36
      },
      "description": "Sesije u razdoblju i koliko ih je stiglo do svakog koraka (svaki uključuje prethodne). Vrijeme na epizodi je procjena.",
      "id": 1
    },
    {
      "type": "bargauge",
      "title": "Lijevak korisnika",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "w": 12,
        "h": 9,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() AS `1. došao`, countIf(ep > 0) AS `2. otvorio epizodu`, countIf(ep > 0 AND days >= 2) AS `3. vratio se drugi dan`, countIf(ep > 0 AND days >= 3) AS `4. aktivan 3+ dana`, countIf(ep > 0 AND days >= 3 AND logged) AS `5. i prijavljen` FROM (SELECT who, uniqExactIf(video_id, video_id != '') AS ep, uniqExact(toDate(ts, 'Europe/Zagreb')) AS days, countIf(user_id != '') > 0 AS logged FROM (SELECT e.*, if(e.user_id != '', e.user_id, if(d.u != '', d.u, e.device_id)) AS who FROM analytics.events AS e LEFT JOIN (SELECT device_id, any(user_id) AS u FROM analytics.events WHERE app = 'domovina.ai' AND user_id != '' GROUP BY device_id) AS d USING device_id WHERE e.app = 'domovina.ai') GROUP BY who HAVING min(ts) >= $__fromTime AND min(ts) <= $__toTime)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "minVizHeight": 16,
        "maxVizHeight": 36
      },
      "description": "Korisnici kojima je prvi dolazak u razdoblju; svaki korak uključuje prethodne. Dani nakon razdoblja se računaju.",
      "id": 2
    },
