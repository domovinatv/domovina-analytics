          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT route AS ruta, countIf(n = 1) AS samo_taj, count() AS ulaza, round(100 * samo_taj / ulaza, 1) AS odbijanje_pct FROM (SELECT session_id, argMin(route, ts) AS route, count() AS n FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) AND event = 'screen_view' GROUP BY session_id) GROUP BY route HAVING ulaza >= 1 ORDER BY ulaza DESC LIMIT 50"
