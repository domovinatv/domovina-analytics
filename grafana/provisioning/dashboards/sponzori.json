            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT round(100 * countIf(event = 'sponsored_play_through') / greatest(countIf(event = 'sponsored_impression'), 1), 1) FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) AND event LIKE 'sponsored_%'"
