      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toStartOfDay(ts, 'Europe/Zagreb') AS time, event, count() AS n FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) AND event LIKE 'sponsored_%' GROUP BY time, event ORDER BY time"
        }
