        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT JSONExtractString(props, 'brand') AS brend, JSONExtractString(props, 'slot_key') AS slot, countIf(event = 'sponsored_impression') AS prikaza, uniqExactIf(if(user_id != '', user_id, device_id), event = 'sponsored_impression') AS slusatelja, countIf(event = 'sponsored_play_through') AS do_kraja, countIf(event = 'sponsored_click') AS klikova, round(100 * do_kraja / greatest(prikaza, 1), 1) AS do_kraja_pct, round(100 * klikova / greatest(prikaza, 1), 2) AS ctr_pct FROM analytics.events WHERE app = 'domovina.ai' AND $__timeFilter(ts) AND event LIKE 'sponsored_%' GROUP BY brend, slot ORDER BY prikaza DESC"
        }
      ],
