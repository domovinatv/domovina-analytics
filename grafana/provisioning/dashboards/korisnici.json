          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT uniqExact(who) FROM (SELECT e.*, if(e.user_id != '', e.user_id, if(d.u != '', d.u, e.device_id)) AS who FROM analytics.events AS e LEFT JOIN (SELECT device_id, any(user_id) AS u FROM analytics.events WHERE app = 'domovina.ai' AND user_id != '' GROUP BY device_id) AS d USING device_id WHERE e.app = 'domovina.ai' AND $__timeFilter(e.ts))"
