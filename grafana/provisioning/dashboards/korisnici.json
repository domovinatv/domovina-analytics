      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT who AS korisnik, if(maxIf(user_id, user_id != '') != '', 'prijavljen', 'gost') AS racun, f.first_ts AS prvi_put, max(ts) AS zadnji_put, uniqExact(session_id) AS sesija, uniqExact(toDate(ts, 'Europe/Zagreb')) AS aktivnih_dana, countIf(event = 'screen_view') AS ekrana, uniqExactIf(video_id, video_id != '') AS epizoda, uniqExact(device_id) AS uredaja, arrayStringConcat(groupUniqArray(platform), ', ') AS platforme, anyLast(country) AS drzava, anyLast(city) AS grad, domainWithoutWWW(argMinIf(JSONExtractString(props, 'referrer'), ts, event = 'session_start')) AS prvi_izvor FROM (SELECT e.*, if(e.user_id != '', e.user_id, if(d.u != '', d.u, e.device_id)) AS who FROM analytics.events AS e LEFT JOIN (SELECT device_id, any(user_id) AS u FROM analytics.events WHERE app = 'domovina.ai' AND user_id != '' GROUP BY device_id) AS d USING device_id WHERE e.app = 'domovina.ai' AND $__timeFilter(e.ts)) AS x LEFT JOIN (SELECT who, min(ts) AS first_ts FROM (SELECT e.*, if(e.user_id != '', e.user_id, if(d.u != '', d.u, e.device_id)) AS who FROM analytics.events AS e LEFT JOIN (SELECT device_id, any(user_id) AS u FROM analytics.events WHERE app = 'domovina.ai' AND user_id != '' GROUP BY device_id) AS d USING device_id WHERE e.app = 'domovina.ai') GROUP BY who) AS f USING who GROUP BY who, f.first_ts ORDER BY zadnji_put DESC LIMIT 2000"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "align": "auto",
            "inspect": true
          }
        },
