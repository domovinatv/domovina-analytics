    {
      "type": "table",
      "title": "Svi korisnici",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "w": 24,
        "h": 22,
        "x": 0,
